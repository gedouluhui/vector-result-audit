include LICENSE README.md README.zh-CN.md
include docs/contract.md docs/integrations.md docs/verification.md docs/index.html
include scripts/mutation_check.py
recursive-include scripts *.py
recursive-include examples *.json *.py
recursive-include integrations *.py *.txt
recursive-include tests *.py
prune .local
prune docs/superpowers
prune .github
prune .superpowers
global-exclude __pycache__ *.py[cod]
